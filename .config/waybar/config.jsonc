// -*- mode: jsonc -*-

{
	"layer":	"top",	// Waybar layer of rendering
	"position":	"top",	// Waybar position (top|bottom|left|right)
//	"width":	1440,	// Waybar width (in pixels, autowidth if removed)
	"height":	30,	// Waybar height (in pixels, autoheight if removed)
	"spacing":	4,	// Gaps between modules (in pixels)
	
	"include": ["~/dotfiles/waybar/modules.jsonc"],

	// Modules positioning

	"modules-left": [	// Order of waybar modules positioned on left
		"hyprland/workspaces"	// Window module
	],

	"modules-center": [	// Order of waybar widgets positioned on center
		"hyprland/window"	// Focused window name module
	],

	"modules-right": [	// Order of waybar widgets positioned on right
		"network",
		"hyprland/language",
		"group/sysinfo",
		"pulseaudio",
		"clock"
	],

	// Groups

	"group/sysinfo": {
		"orientation": "horizontal",
		"modules": [
			"disk",
			"cpu",
			"memory"
		]
	}
}
